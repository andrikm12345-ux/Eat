{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eat",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // Keep the variables and secrets typed into the Cloudflare dashboard when the code is deployed.
  // Public address eat.<account>.workers.dev; no per-version preview addresses.
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "vars": {
    // The free plan allows 10 ms of CPU per request; the full password hashing takes ~45 ms.
    // This cheaper cost is used only here (Netlify keeps the full one); hashes are renewed at the
    // next sign-in. On a paid plan delete this line.
    "SCRYPT_COST": "4096",
  },
  "observability": { "enabled": true },
}
