# Шаблон переменных окружения. Это ТОЛЬКО названия: настоящие значения не коммитим.
# Куда вписывать: Vercel → проект → Settings → Environment Variables (Production).
# Локально для `vercel dev` можно скопировать этот файл в .env.local (он не попадает в git).

# --- Обязательные ---
# Любая случайная строка от 32 символов. Подпись токенов входа И основа идентификаторов
# пользователей (от неё зависят имена файлов с данными в Blob).
# ВАЖНО: менять или терять нельзя. С другим значением все существующие аккаунты и облачные
# данные станут недоступны (логины «исчезнут»). Храните копию в менеджере паролей.
# Vercel не показывает значение после сохранения, восстановить его оттуда нельзя.
AUTH_SECRET=
# Создаётся автоматически, когда к проекту подключают Blob-хранилище (Storage → Blob).
BLOB_READ_WRITE_TOKEN=

# --- ИИ (общий для всех пользователей, ключ только на сервере) ---
# Ключ сервиса ИИ (сейчас TokenHarbor, формат thk_live_…; выпускается в его кабинете).
AI_API_KEY=
# Необязательно. По умолчанию: https://tokenharbor.ai/v1 и mimo-v2.6-flash:free
AI_BASE_URL=
AI_MODEL_TEXT=
AI_MODEL_VISION=
# Запросов к ИИ на человека в сутки (по умолчанию 60).
AI_DAILY_LIMIT=

# --- Интернет-справка для ИИ ---
# Ключ Tavily (tavily.com, кабинет → API Keys).
SEARCH_API_KEY=
SEARCH_DAILY_LIMIT=

# --- Прочее, необязательно ---
# Логины администраторов через запятую.
ADMIN_LOGINS=
# 1 — закрыть регистрацию новых аккаунтов.
SIGNUP_DISABLED=
# Личный текст кнопки «Взвеситься» для отдельных логинов.
USER_LABELS=
# Адрес приёма ошибок из Better Stack (Errors → приложение → DSN). Попадает в сборку.
VITE_SENTRY_DSN=
